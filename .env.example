# Copy to .env (never commit a real .env) and adjust as needed.
# docker-compose.yml reads these with sensible dev defaults.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/pokemanager
DB_NAME=pokemanager
DB_USER=pokemanager
DB_PASSWORD=pokemanager

# --- Security ---
# MUST be >= 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-pokemanager-dev-secret-please-override

# --- Upstream PokeAPI ---
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
